# ---------------------------------------------------------------------------
# Fire Arena backend — environment template
# Copy to `.env` (or export in your host) and fill in real values.
# ---------------------------------------------------------------------------

# HTTP port (Render/Railway/Fly inject PORT automatically)
PORT=4000
NODE_ENV=development

# REQUIRED in production: at least 16 characters. Used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# JSON-file store location. Use a persistent disk in production.
DATA_FILE=./data/arena.json

# Seed demo users/matches on first boot (set to false in production)
AUTO_SEED=true

# How often the scheduled expiration/refund job runs (milliseconds)
EXPIRY_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (optional, but required for REAL device push)
# ---------------------------------------------------------------------------
# Paste the service-account JSON on ONE line (recommended: secret manager):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# …or point to a mounted file:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Public Firebase web config handed to the user app (safe to expose).
# Include your Web Push certificate key as `vapidKey`.
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","vapidKey":"B..."}
