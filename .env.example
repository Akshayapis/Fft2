# ===========================================================================
# Fire Arena — complete environment reference
# Copy the relevant sections into backend/.env, user-app/.env, admin-app/.env
# Never commit real credentials. In GitHub Actions use repository secrets.
# ===========================================================================

# ---------------------------- backend --------------------------------------
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
DATA_FILE=./data/arena.json
AUTO_SEED=false
EXPIRY_INTERVAL_MS=30000

# Firebase Admin (real FCM push + optional Firebase Auth migration)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Public Firebase web config served to the user app (needed for FCM web push)
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","vapidKey":"B..."}

# ---------------------------- frontends ------------------------------------
# Leave VITE_API_URL empty when using the bundled dev proxy / same-origin hosting.
VITE_API_URL=
VITE_API_PROXY=http://127.0.0.1:4000

# ---------------------- GitHub Actions secrets ------------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_SCOPE=
# VERCEL_PROJECT_ID_USER=
# VERCEL_PROJECT_ID_ADMIN=
# USER_APP_API_URL=
# ADMIN_APP_API_URL=
# BACKEND_DEPLOY_HOOK=
# BACKEND_HEALTH_URL=
# USER_APP_URL=
# ADMIN_APP_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT=
